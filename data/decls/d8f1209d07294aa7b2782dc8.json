StressActivation.FromReference.refAxial N r.refTime;\n  have I := NavierStokes.ActivationStocks.FromReference.initial N ⋯ ⋯ P0 hP0;\n  ∃ θ > 0,\n    θ ≤ 1 ∧\n      ∀ y ∈ Set.Ioc 0 r.actTime,\n        ∀ η ∈ Set.Icc (-1) 1,\n          NavierStokes.StressActivation.activation r.actTime r.kappa y ≤\n              NavierStokes.ActivationCone.activatedProjection h N.endpoint I L U r.actTime r.kappa (y, η) -\n                NavierStokes.StressActivation.shearSize r.actTime r.kappa N.endpoint L U (y, η) ∧\n            2 + 1 / 32 < NavierStokes.ActivationCone.activatedProjection h N.endpoint I L U r.actTime r.kappa (y, η) ∧\n              (NavierStokes.StressActivation.shearSize r.actTime r.kappa N.endpoint L U (y, η) - 2) *\n                    NavierStokes.ActivationCone.activatedCross h N.endpoint I L U r.actTime r.kappa (y, η) ^ 2 <\n                  2 *\n                    (NavierStokes.ActivationCone.activatedProjection h N.endpoint I L U r.actTime r.kappa (y, η) -\n                        NavierStokes.StressActivation.shearSize r.actTime r.kappa N.endpoint L U (y, η)) ^\n                      2 ∧\n                NavierStokes.StressActivation.shearSize r.actTime r.kappa N.endpoint L U (y, η) <\n                    NavierStokes.ConeAlgebra.coneBound\n                      (NavierStokes.ActivationCone.activatedProjection h N.endpoint I L U r.actTime r.kappa (y, η))\n                      (NavierStokes.ActivationCone.activatedCross h N.endpoint I L U r.actTime r.kappa (y, η)) ∧\n                  (y ≤ θ * r.actTime →\n                    2 + 1 / 16 < NavierStokes.StressActivation.shearSize r.actTime r.kappa N.endpoint L U (y, η))"}}
