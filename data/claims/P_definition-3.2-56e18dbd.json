{"anchor": {"begin": [18, 0, 440.0], "end": [18, 0, 476.67], "env": "definition", "file": null, "head": null, "id": 3, "kind": "approximate", "label": null, "labels": [], "line": null, "number": "3.2", "source_sha256": "7c8eddaceba0a15b88fa73df8c88c6e14ed84b8c32af4991616aa6486fbf0c1f", "statement": "Definition 3.2 (Regularity at the axis). A leading field is regular at the axis if its velocity and pressure extend smoothly across r = 0 in Cartesian coordinates, for t < 1. For scalar auxiliary profiles, “regular at the axis” means a smooth extension in (X, η ) to X = 0.", "title": "Regularity at the axis"}, "blockers": [], "class": "unspecified", "clauses": [], "correspondence": null, "decls": {}, "findings": [], "heading": "Regularity at the axis", "id": "P:definition-3.2", "key": "definition-3.2", "kind": "definition", "links": [], "location": null, "mode": "simple", "number": "Definition 3.2", "paper": "P", "release": "v-b425cdad8e3a", "reviews": [], "schema": "prooflens/manifest@1", "scope": "definition", "scope_note": "", "scope_reviewed": true, "source_evidence": {"pdf_integrity": "unpinned", "placement": "approximate", "state": "pdf-only"}, "source_matches": null, "source_sha256": "7c8eddaceba0a15b88fa73df8c88c6e14ed84b8c32af4991616aa6486fbf0c1f", "statement_tex": null, "status": "not linked", "status_code": "link.none", "suggestions": [], "title": "Regularity at the axis"}
