{"anchor": {"begin": [80, 0, 368.0], "end": [80, 0, 417.33], "env": "corollary", "file": null, "head": null, "id": 29, "kind": "approximate", "label": null, "labels": [], "line": null, "number": "7.3", "source_sha256": "5b6abded7130315f67531a0dbf17c8dd67115ea508e7ee620b7cc2ed705fa0b5", "statement": "Corollary 7.3. The solution operators f m ↦→ (t m , π m ) for the projected amplitude equation with t m (0) = 0 are defined at every finite correction stage on the same domain 0 < q < q ∗ . Increasing the finite harmonic set or the derivative order changes constants and polynomial degrees, but does not require shrinking this domain.", "title": null}, "blockers": [], "class": "unspecified", "clauses": [], "correspondence": null, "decls": {}, "findings": [], "heading": null, "id": "P:corollary-7.3", "key": "corollary-7.3", "kind": "corollary", "links": [], "location": null, "mode": "simple", "number": "Corollary 7.3", "paper": "P", "release": "v-388d8b988079", "schema": "prooflens/manifest@1", "scope": "formal", "scope_note": "", "scope_reviewed": true, "source_evidence": {"pdf_integrity": "unpinned", "placement": "approximate", "state": "pdf-only"}, "source_matches": null, "source_sha256": "5b6abded7130315f67531a0dbf17c8dd67115ea508e7ee620b7cc2ed705fa0b5", "statement_tex": null, "status": "not linked", "status_code": "link.none", "suggestions": [], "title": ""}
